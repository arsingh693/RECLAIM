# Copy to `.env.local` and fill in. Never commit `.env.local`.

# --- Model provider -------------------------------------------------------
# Which provider the intervention policy uses. One of: gemini | anthropic | openai | stub
# `stub` runs a deterministic rule-based stand-in so the pipeline works with no key at all.
LLM_PROVIDER=stub

# Only the key for your chosen provider is needed.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Payment gateway ------------------------------------------------------
# simulated | razorpay
# `simulated` is the default and is what the reported metrics are measured on,
# because the baseline-vs-agent comparison is only honest if the batch is
# reproducible. See README.
PAYMENT_GATEWAY=simulated

# Test-mode credentials. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Run configuration ----------------------------------------------------
# Seed controls batch generation. Same seed, same batch, every time.
BATCH_SEED=buildathon-2026
BATCH_SIZE=400
